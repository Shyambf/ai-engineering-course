# Шаблон переменных окружения для Модуля 1.
# Реальный .env лежит в КОРНЕ проекта (создан в Задании 2) и в Git не коммитится.

# GigaChat — основной провайдер.
# Получить: developers.sber.ru/studio → проект → Данные для авторизации запросов к API
# Нужен именно Authorization key, а НЕ Client ID.
GIGACHAT_CREDENTIALS=ваш_authorization_key

# Область действия ключа. Для личного аккаунта — GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# HuggingFace — резервный провайдер (fallback в Задании 4).
# Получить: huggingface.co → Settings → Access Tokens → New token →
#   ТИП Fine-grained → раздел Inference → галочка "Make calls to Inference Providers".
# Без этой галочки будет ошибка 403.
HF_API_KEY=hf_...
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
